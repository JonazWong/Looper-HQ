# App
NEXT_PUBLIC_APP_NAME="Looper HQ"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-change-in-production-use-openssl-rand-base64-32

# Keycloak OAuth Configuration
KEYCLOAK_CLIENT_ID=looper-hq
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/looper-hq
# Alternative format: KEYCLOAK_URL=http://localhost:8080 and KEYCLOAK_REALM=looper-hq

# Database (will use from root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/defaultdb
