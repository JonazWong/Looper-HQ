# ===========================
# Database Configuration
# ===========================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/looper_hq"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=looper_hq
POSTGRES_PORT=5432

# Keycloak Database
KEYCLOAK_DB=keycloak

# ===========================
# Redis Configuration
# ===========================
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password-here

# ===========================
# Keycloak Configuration
# ===========================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_FRONTEND_URL=http://localhost:8080
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=looper-hq
KEYCLOAK_CLIENT_ID=looper-hq-web
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Legal Case Search Keycloak Client
LEGAL_CASE_SEARCH_CLIENT_ID=legal-case-search
LEGAL_CASE_SEARCH_CLIENT_SECRET=your-legal-case-client-secret-here

# ===========================
# pgAdmin Configuration (Optional)
# ===========================
PGADMIN_EMAIL=admin@looper-hq.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ===========================
# NextAuth Configuration
# ===========================
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Legal Case Search NextAuth
LEGAL_CASE_NEXTAUTH_URL="http://localhost:3001"

# ===========================
# Application Configuration
# ===========================
NODE_ENV=development
TZ=Asia/Hong_Kong

# Application Ports
WEB_APP_PORT=3000
LEGAL_CASE_SEARCH_PORT=3001

# ===========================
# Public Case Tracking & Crawler
# ===========================
CRAWLER_ENABLED=true
CRAWLER_SCHEDULE="0 18 * * *"  # Daily at 2am HKT (18:00 UTC)
RSS_TIMEOUT=30000              # 30 seconds
RSS_MAX_RETRIES=3
RSS_USER_AGENT="Looper-HQ/1.0"

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000     # 1 minute

# OpenAI API (AI Classification & Analysis)
# ===========================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1
