# ===========================
# Database Configuration
# ===========================
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/defaultdb"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=defaultdb
POSTGRES_PORT=5433

# Keycloak Database
KEYCLOAK_DB=keycloak

# ===========================
# Redis Configuration
# ===========================
REDIS_URL="redis://localhost:6380"
REDIS_PORT=6380
# REDIS_PASSWORD=your-redis-password-here

# ===========================
# Keycloak Configuration
# ===========================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_FRONTEND_URL=http://localhost:8080
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=looper-hq
KEYCLOAK_CLIENT_ID=looper-hq-web
KEYCLOAK_CLIENT_SECRET=looper-hq-local-dev-secret
NEXT_PUBLIC_KEYCLOAK_ENABLED=true
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=looper-hq
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=looper-hq-web

# Legal Case Search Keycloak Client
LEGAL_CASE_SEARCH_CLIENT_ID=legal-case-search
LEGAL_CASE_SEARCH_CLIENT_SECRET=your-legal-case-client-secret-here

# ===========================
# pgAdmin Configuration (Optional)
# ===========================
PGADMIN_EMAIL=admin@looper-hq.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ===========================
# NextAuth Configuration
# ===========================
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3005"

# Legal Case Search NextAuth
LEGAL_CASE_NEXTAUTH_URL="http://localhost:3001"

# ===========================
# Application Configuration
# ===========================
NODE_ENV=development
TZ=Asia/Hong_Kong

# Application Ports
WEB_APP_PORT=3005
LEGAL_CASE_SEARCH_PORT=3001

# ===========================
# Public Case Tracking & Crawler
# ===========================
CRAWLER_ENABLED=true
CRAWLER_SCHEDULE="30 18 * * *"  # Daily at 2:30am HKT (18:30 UTC)
RSS_TIMEOUT=30000               # 30 seconds
RSS_MAX_RETRIES=3
RSS_USER_AGENT="Looper-HQ/2.0 (Hong Kong Legal Case Management)"

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000     # 1 minute

# ===========================
# AI Configuration (統一設定)
# ===========================
# AI Provider 基本設定
AI_PROVIDER=openai          # openai | openrouter | azure | custom
AI_DEFAULT_LOCALE=zh-HK
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# OpenAI / OpenRouter (擇一使用)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter 專用（可選）
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Azure OpenAI（可選）
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===========================
# Embedding Configuration
# ===========================
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# ===========================
# AI Pipeline
# ===========================
AI_PIPELINE_BATCH_SIZE=10
AI_SUMMARIZE_MAX_LENGTH=500

# ===========================
# Airwallex 付款整合
# ===========================
# 環境: demo（測試）| prod（正式）
AIRWALLEX_ENV=demo
NEXT_PUBLIC_AIRWALLEX_ENV=demo

# Airwallex API 憑證（從 Airwallex Dashboard 取得）
AIRWALLEX_CLIENT_ID=your-airwallex-client-id
AIRWALLEX_API_KEY=your-airwallex-api-key

# Webhook 簽名密鑰（用於驗證 Webhook 請求合法性）
AIRWALLEX_WEBHOOK_SECRET=your-airwallex-webhook-secret
