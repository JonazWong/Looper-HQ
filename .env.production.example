# ============================================
# Production Environment Variables
# ============================================

# Application
NODE_ENV=production
PORT=3000

# Database (Digital Ocean Managed PostgreSQL)
DATABASE_URL=postgresql://user:password@db.digitalocean.com:25060/looper_hq?sslmode=require

# NextAuth
NEXTAUTH_URL=https://looper-hq.app
NEXTAUTH_SECRET=your-production-secret-here

# OpenRouter API
OPENAI_API_KEY=sk-or-v1-production-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=anthropic/claude-3.5-sonnet

# Keycloak
KEYCLOAK_CLIENT_ID=looper-hq-production
KEYCLOAK_CLIENT_SECRET=your-keycloak-secret
KEYCLOAK_ISSUER=https://auth.looper-hq.app/realms/looper-hq

# Monitoring (Optional)
SENTRY_DSN=https://xxx@sentry.io/xxx
ENABLE_ANALYTICS=true

# Digital Ocean
DIGITALOCEAN_SPACES_KEY=your-spaces-key
DIGITALOCEAN_SPACES_SECRET=your-spaces-secret
DIGITALOCEAN_SPACES_ENDPOINT=sgp1.digitaloceanspaces.com
DIGITALOCEAN_SPACES_BUCKET=looper-hq-assets
