# 🔐 生產環境變數範本
# 
# 重要：此文件僅作為範本參考，不要包含真實的密鑰！
# 在 DigitalOcean App Platform 的 Environment Variables 中設置這些值

# === 應用程式基本設定 ===
NODE_ENV=production
PORT=3000

# === 應用程式 URL（替換為您的域名）===
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# === 資料庫（由 DigitalOcean 自動注入）===
# 格式：postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=${db.DATABASE_URL}

# === NextAuth.js 認證 ===
# URL 必須與應用程式 URL 一致
NEXTAUTH_URL=https://your-domain.com

# 使用 openssl 生成：openssl rand -base64 32
NEXTAUTH_SECRET=<生成的 32 字元密鑰>

# === Google OAuth（可選）===
# 從 Google Cloud Console 獲取
GOOGLE_CLIENT_ID=<您的 Google Client ID>
GOOGLE_CLIENT_SECRET=<您的 Google Client Secret>

# === 其他可選設定 ===
# SMTP 郵件發送（如需要）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=<應用程式密碼>

# Redis 快取（如需要）
# REDIS_URL=redis://:<password>@<host>:<port>

# Sentry 錯誤追蹤（如需要）
# SENTRY_DSN=<您的 Sentry DSN>

# === OpenAI API（AI 分類與分析）===
# 從 OpenAI Platform 獲取 API Key
OPENAI_API_KEY=<您的 OpenAI API Key>
OPENAI_MODEL=gpt-4o-mini
