# ============================================================================
# Looper HQ - Production Environment Variables Example
# ============================================================================
# This file contains all environment variables needed for production deployment
# to Digital Ocean App Platform.
#
# ⚠️ SECURITY WARNING:
# - Never commit actual secrets to version control
# - Set sensitive values in Digital Ocean App Platform UI
# - Use strong, randomly generated passwords and secrets
#
# 📋 Setup Instructions:
# 1. Most variables are auto-configured in .do/app.yaml
# 2. Secrets marked as REQUIRED must be set in DO App Platform UI
# 3. Optional variables can be omitted if not using the feature
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Auto-injected by Digital Ocean Managed Database
# DO NOT set manually - Digital Ocean provides this automatically
DATABASE_URL=postgresql://user:password@host:5432/defaultdb

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
# Auto-configured in .do/app.yaml
NODE_ENV=production
TZ=Asia/Hong_Kong

# ============================================================================
# NEXTAUTH CONFIGURATION (Authentication)
# ============================================================================
# REQUIRED: Set in Digital Ocean App Platform UI

# App URL - auto-configured from ${APP_URL}
NEXTAUTH_URL=https://your-app.ondigitalocean.app

# REQUIRED: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-generated-secret-here-min-32-characters

# ============================================================================
# KEYCLOAK OAUTH (Optional)
# ============================================================================
# Only required if using Keycloak for SSO authentication
# If not using Keycloak, the app will use credentials provider

# KEYCLOAK_CLIENT_ID=looper-hq-web
# KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
# KEYCLOAK_ISSUER=https://your-keycloak-domain.com/realms/looper-hq

# ============================================================================
# AI PROVIDER CONFIGURATION
# ============================================================================
# REQUIRED: For AI-powered features (case classification, analysis)

# AI Provider selection (openai, anthropic)
AI_PROVIDER=openai

# REQUIRED: Your OpenAI or OpenRouter API key
# Get from: https://openrouter.ai/keys or https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-or-v1-your-api-key-here

# AI Model configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# AI Parameters
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_DEFAULT_LOCALE=zh-HK

# ============================================================================
# PUBLIC CASE CRAWLER CONFIGURATION
# ============================================================================
# Auto-configured in .do/app.yaml

# Enable/disable automated case tracking
CRAWLER_ENABLED=true

# Cron schedule (Daily at 2am HKT / 18:00 UTC previous day)
CRAWLER_SCHEDULE=0 18 * * *

# RSS Feed settings
RSS_TIMEOUT=30000
RSS_MAX_RETRIES=3
RSS_USER_AGENT=Looper-HQ/2.0 (Hong Kong Legal Case Management)

# ============================================================================
# HEALTH CHECK CONFIGURATION (Optional)
# ============================================================================
# Secret for accessing detailed health metrics in production
# Generate with: openssl rand -base64 32
# HEALTH_CHECK_SECRET=your-generated-secret-here

# ============================================================================
# RATE LIMITING (Optional)
# ============================================================================
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# MONITORING & ANALYTICS (Optional)
# ============================================================================
# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn
# SENTRY_ENVIRONMENT=production

# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================================================
# DIGITAL OCEAN SPACES (Optional)
# ============================================================================
# For file uploads and storage
# DO_SPACES_ENDPOINT=sgp1.digitaloceanspaces.com
# DO_SPACES_BUCKET=looper-hq-files
# DO_SPACES_ACCESS_KEY_ID=your-access-key
# DO_SPACES_SECRET_ACCESS_KEY=your-secret-key

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# For sending notifications and transactional emails
# EMAIL_FROM=noreply@looper-hq.com
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# ============================================================================
# REDIS CONFIGURATION (Optional)
# ============================================================================
# For caching and session storage
# REDIS_URL=redis://user:password@host:25061

# ============================================================================
# DEPLOYMENT INFORMATION
# ============================================================================
# Auto-set by Digital Ocean App Platform
# DEPLOYMENT_ID=auto-generated-by-do
# GIT_COMMIT_SHA=auto-generated-by-do
# APP_VERSION=2.0.0

# ============================================================================
# SETUP CHECKLIST
# ============================================================================
# Before deploying, ensure you have:
# 
# ✅ Required Secrets (set in DO App Platform UI):
#    - NEXTAUTH_SECRET (generate: openssl rand -base64 32)
#    - OPENAI_API_KEY (from OpenRouter or OpenAI)
#    - DATABASE_URL (auto-injected by DO Managed Database)
#
# ✅ Optional but Recommended:
#    - Keycloak credentials (if using SSO)
#    - Sentry DSN (for error monitoring)
#    - Email SMTP credentials (for notifications)
#
# ✅ Verify in Digital Ocean:
#    - Database is created and running
#    - Environment variables are set in App Settings
#    - Domain is configured (if using custom domain)
#    - Health check endpoint responds: /api/health
#
# 📚 Documentation:
#    - See: docs/deployment-guide.md
#    - DO App Platform: https://cloud.digitalocean.com/apps
# ============================================================================
