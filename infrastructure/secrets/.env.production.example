################################################################################
# Looper HQ - Production Environment Variables
# Copy this file to .env.production and fill in the actual values
################################################################################

# Node Environment
NODE_ENV=production

# Application
NEXT_PUBLIC_APP_NAME="Looper HQ"
NEXT_PUBLIC_APP_URL=https://your-domain.com

# PostgreSQL Database
POSTGRES_USER=looper_admin
POSTGRES_PASSWORD=<GENERATE_SECURE_PASSWORD>
POSTGRES_DB=looper_hq
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Keycloak Database
KEYCLOAK_DB=keycloak

# Redis
REDIS_PASSWORD=<GENERATE_SECURE_PASSWORD>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=<GENERATE_WITH_OPENSSL>

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<GENERATE_SECURE_PASSWORD>
KEYCLOAK_HOSTNAME=your-domain.com
KEYCLOAK_CLIENT_ID=looper-hq-client
KEYCLOAK_CLIENT_SECRET=<GENERATE_IN_KEYCLOAK_ADMIN>
KEYCLOAK_ISSUER=https://your-domain.com/auth/realms/looper-hq

# Monitoring (Optional)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<GENERATE_SECURE_PASSWORD>
GRAFANA_ROOT_URL=https://your-domain.com/grafana

# Email/SMTP (Optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=<YOUR_APP_PASSWORD>
# SMTP_FROM=noreply@your-domain.com

# Sentry (Optional - for error tracking)
# NEXT_PUBLIC_SENTRY_DSN=<YOUR_SENTRY_DSN>
# SENTRY_AUTH_TOKEN=<YOUR_SENTRY_AUTH_TOKEN>

# File Upload (Optional)
# UPLOAD_MAX_SIZE=20971520  # 20MB in bytes
# ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# API Rate Limiting
# API_RATE_LIMIT=100  # requests per minute
# LOGIN_RATE_LIMIT=5   # requests per minute

# Backup Configuration (Optional)
# BACKUP_S3_BUCKET=looper-hq-backups
# AWS_ACCESS_KEY_ID=<YOUR_ACCESS_KEY>
# AWS_SECRET_ACCESS_KEY=<YOUR_SECRET_KEY>
# AWS_REGION=sgp1  # DigitalOcean Spaces region

################################################################################
# Security Notes:
# 1. Never commit this file with real values to git
# 2. Use strong, unique passwords for all services
# 3. Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# 4. Rotate secrets regularly
# 5. Restrict file permissions: chmod 600 .env.production
################################################################################
