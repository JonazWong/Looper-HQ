{
  "realm": "looper-hq",
  "enabled": true,
  "displayName": "Looper HQ",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Looper HQ</span></div>",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "defaultLocale": "en",
  "supportedLocales": ["en", "zh-CN", "zh-TW"],
  "internationalizationEnabled": true,
  "loginTheme": "keycloak",
  "accountTheme": "keycloak",
  "adminTheme": "keycloak",
  "emailTheme": "keycloak",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "clients": [
    {
      "clientId": "looper-hq-web",
      "name": "Looper HQ Web Application",
      "description": "Main web application client",
      "enabled": true,
      "publicClient": false,
      "secret": "looper-hq-local-dev-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3005/*",
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://localhost:3005/api/auth/callback/keycloak",
        "https://www.looperhq.hk/*",
        "https://www.looperhq.hk/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3005",
        "https://www.looperhq.hk"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "email",
        "profile",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "legal-case-search",
      "name": "Legal Case Search Application",
      "description": "Legal case management and search client",
      "enabled": true,
      "publicClient": false,
      "secret": "legal-case-search-local-dev-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/*",
        "http://localhost:3001/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "email",
        "profile",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard user role"
      },
      {
        "name": "lawyer",
        "description": "Lawyer role with case management access"
      },
      {
        "name": "admin",
        "description": "Administrator role with full access"
      },
      {
        "name": "client",
        "description": "Client role for case inquiry"
      }
    ]
  },
  "groups": [
    {
      "name": "lawyers",
      "path": "/lawyers",
      "realmRoles": ["lawyer"]
    },
    {
      "name": "clients",
      "path": "/clients",
      "realmRoles": ["client"]
    },
    {
      "name": "admins",
      "path": "/admins",
      "realmRoles": ["admin"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@looper-hq.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"],
      "groups": ["/admins"]
    },
    {
      "username": "lawyer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Lawyer",
      "lastName": "User",
      "email": "lawyer@looper-hq.local",
      "credentials": [
        {
          "type": "password",
          "value": "lawyer123",
          "temporary": false
        }
      ],
      "realmRoles": ["lawyer", "user"],
      "groups": ["/lawyers"]
    },
    {
      "username": "client",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Client",
      "lastName": "User",
      "email": "client@looper-hq.local",
      "credentials": [
        {
          "type": "password",
          "value": "client123",
          "temporary": false
        }
      ],
      "realmRoles": ["client", "user"],
      "groups": ["/clients"]
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "description": "OpenID Connect scope for add user roles to the access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "attributes": {
    "frontendUrl": "http://localhost:8080",
    "cibaBackchannelTokenDeliveryMode": "poll",
    "cibaExpiresIn": "120",
    "cibaAuthRequestedUserHint": "login_hint",
    "parRequestUriLifespan": "60"
  }
}
