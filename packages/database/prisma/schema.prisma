generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector(map: "vector")]
}

// User & Authentication
model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  role       UserRole @default(CLIENT)
  keycloakId String?  @unique
  avatar     String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Firm relationship (for legal case search)
  firmId    String?
  firm      Firm?   @relation(fields: [firmId], references: [id])
  firmOwner Boolean @default(false)

  // Relations
  cases             Case[]          @relation("ClientCases")
  assignedCases     Case[]          @relation("AssignedLawyer")
  activities        Activity[]
  documents         Document[]
  memberships       Membership[]
  timeEntries       TimeEntry[]
  uploadedDocuments LegalDocument[]

  @@index([firmId])
  @@map("users")
}

enum UserRole {
  ADMIN
  LAWYER
  CLIENT
  STAFF
}

// Case Management
model Case {
  id          String       @id @default(cuid())
  caseNumber  String       @unique // e.g., "HK-2026-001"
  
  // Bilingual fields
  title_zh       String
  title_en       String
  description_zh String?      @db.Text
  description_en String?      @db.Text
  
  status      CaseStatus   @default(ACTIVE)
  priority    Priority     @default(MEDIUM)
  category    CaseCategory

  // Parties
  clientId String
  client   User    @relation("ClientCases", fields: [clientId], references: [id])
  lawyerId String?
  lawyer   User?   @relation("AssignedLawyer", fields: [lawyerId], references: [id])

  // Firm relationship (for legal case search)
  firmId String?
  firm   Firm?   @relation(fields: [firmId], references: [id])

  // Financial
  budget   Decimal?  @db.Decimal(12, 2)
  deadline DateTime?

  // Metadata
  startDate      DateTime  @default(now())
  endDate        DateTime?
  courtDate      DateTime?
  estimatedValue Decimal?  @db.Decimal(12, 2)

  // Visibility
  isPublic       Boolean @default(false)
  publicNote_zh  String? @db.Text
  publicNote_en  String? @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  documents      Document[]
  activities     Activity[]
  timeLogs       TimeLog[]
  invoices       Invoice[]
  notes          CaseNote[]
  timeEntries    TimeEntry[]
  legalDocuments LegalDocument[]

  @@index([status, priority])
  @@index([clientId])
  @@index([lawyerId])
  @@index([caseNumber])
  @@index([firmId])
  @@map("cases")
}

enum CaseStatus {
  DRAFT
  OPEN
  ACTIVE
  IN_PROGRESS
  PENDING
  COMPLETED
  CLOSED
  ARCHIVED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CaseCategory {
  CIVIL
  CRIMINAL
  CRIMINAL_APPEAL
  CORPORATE
  FAMILY
  PROPERTY
  EMPLOYMENT
  INTELLECTUAL_PROPERTY
  ADMINISTRATIVE        // 行政法
  CONSTITUTIONAL        // 憲法/基本法
  IMMIGRATION           // 入境事務
  PERSONAL_INJURY       // 人身傷害
  TORT                  // 侵權法
  CONTRACT              // 合約法
  BANKRUPTCY_INSOLVENCY // 破產/清盤
  SECURITIES            // 證券法
  ARBITRATION           // 仲裁
  JUDICIAL_REVIEW       // 司法覆核
  HUMAN_RIGHTS          // 人權法
  COMPETITION           // 競爭法
  TAX                   // 稅務
  OTHER
}

enum CourtLevel {
  CFA         // 終審法院 Court of Final Appeal
  CA          // 上訴法庭 Court of Appeal
  CFI         // 原訟法庭 Court of First Instance
  DC          // 區域法院 District Court
  FC          // 家事法庭 Family Court
  MC          // 裁判法院 Magistrates Courts
  LT          // 土地審裁處 Lands Tribunal
  LABOUR      // 勞資審裁處 Labour Tribunal
  SAR         // 小額錢債審裁處
  COMPETITION // 競爭事務審裁處
  OTHER
}

// Client Information
model Client {
  id     String  @id @default(cuid())
  userId String?

  // Personal/Company Info
  clientType  ClientType @default(INDIVIDUAL)
  fullName    String
  companyName String?
  idNumber    String?    @unique
  businessReg String?    @unique

  // Contact
  email   String  @unique
  phone   String
  address String? @db.Text

  // Bilingual notes
  notes_zh String? @db.Text
  notes_en String? @db.Text

  // Membership
  membershipTier MembershipTier @default(BASIC)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum MembershipTier {
  BASIC
  STANDARD
  PREMIUM
  PREMIER
}

// Membership Records
model Membership {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  tier      MembershipTier
  startDate DateTime       @default(now())
  endDate   DateTime?
  isActive  Boolean        @default(true)

  // Benefits
  searchLimit Int  @default(10) // searches per month
  caseLimit   Int? // max active cases

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@map("memberships")
}

// Document Management
model Document {
  id           String  @id @default(cuid())
  caseId       String?
  case         Case?   @relation(fields: [caseId], references: [id])
  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id])

  // File Info
  fileName String
  fileSize Int // bytes
  fileType String // MIME type
  fileUrl  String // S3/storage URL

  // Metadata
  category       DocumentCategory
  description    String?          @db.Text
  isConfidential Boolean          @default(false)

  // Timestamps
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([caseId])
  @@map("documents")
}

enum DocumentCategory {
  CONTRACT
  EVIDENCE
  COURT_FILING
  CORRESPONDENCE
  INVOICE
  OTHER
}

// Activity Log
model Activity {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  // Activity Details
  activityType ActivityType
  action       String
  description  String?      @db.Text
  metaData     Json? // Additional data (renamed from metadata to avoid SQLAlchemy conflict)

  // Timestamp
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([caseId, createdAt])
  @@map("activities")
}

enum ActivityType {
  CASE_CREATED
  CASE_UPDATED
  CASE_CLOSED
  DOCUMENT_UPLOADED
  CLIENT_ADDED
  MEETING_SCHEDULED
  PAYMENT_RECEIVED
  NOTE_ADDED
  STATUS_CHANGED
}

// Time Tracking
model TimeLog {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  // Time Details
  description String
  hours       Decimal  @db.Decimal(5, 2)
  hourlyRate  Decimal? @db.Decimal(8, 2)
  billable    Boolean  @default(true)

  // Date
  logDate   DateTime
  createdAt DateTime @default(now())

  @@index([caseId, logDate])
  @@map("time_logs")
}

// Billing
model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique
  caseId        String
  case          Case   @relation(fields: [caseId], references: [id])

  // Firm relationship (for legal case search)
  firmId String?
  firm   Firm?   @relation(fields: [firmId], references: [id])

  // Time entries
  timeEntries TimeEntry[]

  // Amount
  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("HKD")
  status   InvoiceStatus @default(PENDING)

  // Dates
  issueDate DateTime  @default(now())
  dueDate   DateTime
  paidDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueDate])
  @@index([firmId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// Case Notes
model CaseNote {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  // Bilingual fields
  content_zh String @db.Text
  content_en String @db.Text
  
  isPrivate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId, createdAt])
  @@map("case_notes")
}

// Public Case Search History (for non-members)
model SearchHistory {
  id           String   @id @default(cuid())
  ipAddress    String
  query        String
  resultsCount Int
  searchedAt   DateTime @default(now())

  @@index([ipAddress, searchedAt])
  @@map("search_history")
}

// ============================================
// Legal Case Search Application Models
// ============================================

// Firm/Law Office Management
model Firm {
  id      String  @id @default(cuid())
  name    String
  email   String  @unique
  phone   String?
  address String? @db.Text
  website String?

  // Subscription
  subscription SubscriptionTier @default(STARTER)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users        User[]
  legalClients LegalClient[]
  cases        Case[]
  invoices     Invoice[]

  @@map("firms")
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

// Legal Client (separate from User-based Client)
model LegalClient {
  id      String  @id @default(cuid())
  name    String
  email   String  @unique
  phone   String?
  company String?
  address String? @db.Text

  // Firm relationship
  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id])

  // Relations
  messages Message[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
  @@map("legal_clients")
}

// Time Entry for billing
model TimeEntry {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Time details
  description String  @db.Text
  hours       Decimal @db.Decimal(5, 2)
  rate        Decimal @db.Decimal(8, 2)
  amount      Decimal @db.Decimal(10, 2)
  billable    Boolean @default(true)
  invoiced    Boolean @default(false)

  // Invoice relationship
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  // Date
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([userId])
  @@index([invoiceId])
  @@map("time_entries")
}

// Legal Document (separate from general Document)
model LegalDocument {
  id           String @id @default(cuid())
  caseId       String
  case         Case   @relation(fields: [caseId], references: [id])
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  // File info
  name     String
  fileType String // MIME type (renamed from type to avoid Python/SQLAlchemy conflict)
  size     Int    // bytes
  url      String // Storage URL

  // Timestamps
  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("legal_documents")
}

// Client Messages/Communications
model Message {
  id       String      @id @default(cuid())
  clientId String
  client   LegalClient @relation(fields: [clientId], references: [id])

  subject String
  content String  @db.Text
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("messages")
}

// ============================================
// Public Case Tracking & RSS Integration
// ============================================

// Public Case from external sources (HK Judiciary, RSS News, etc.)
model PublicCase {
  id          String     @id @default(cuid())
  
  // Source identification
  source      CaseSource
  externalId  String     // External source case ID
  sourceUrl   String?    // Source URL
  
  // Case information
  caseNumber  String?       // e.g., HCAL 123/2024
  
  // Bilingual fields
  title_zh       String
  title_en       String
  description_zh String? @db.Text
  description_en String? @db.Text
  
  category    CaseCategory? // Case category (enum)
  court       String?       // Court name
  
  // Parties
  parties     Json?      // { plaintiff: [], defendant: [] }
  
  // Judge and judgment
  judge          String?
  judgmentDate   DateTime?
  judgment_zh    String? @db.Text
  judgment_en    String? @db.Text
  
  // Keywords and tags
  keywords    String[]
  tags        String[]
  
  // News source additional fields
  publishedAt DateTime?  // News publish time
  author      String?    // News author
  
  // Full-text search vector
  searchVector Unsupported("tsvector")? @map("search_vector")
  
  // New fields for HKLII integration
  neutralCitation String?    // e.g. [2024] HKCFA 1
  courtLevel      CourtLevel?
  fullText        String?    @db.Text // Full judgment text
  
  // Case citation relations
  citingCases  CaseCitation[] @relation("CitingCase")
  citedByCases CaseCitation[] @relation("CitedCase")
  
  // Metadata
  crawledAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  // AI Pipeline relations
  embeddings      Embedding[]
  classifications Classification?
  translations    Translation[]
  summaries       Summary?
  
  @@unique([source, externalId])
  @@index([source, crawledAt])
  @@index([caseNumber])
  @@index([keywords])
  @@index([publishedAt])
  @@index([neutralCitation])
  @@index([searchVector], type: Gin)
  @@map("public_cases")
}

enum CaseSource {
  HK_JUDICIARY
  MINGPAO_PNS_RSS
  MINGPAO_INS_RSS
  HKLII
  HKGOVNEWS_RSS
}

// Case Citation - tracks which cases cite which other cases
model CaseCitation {
  id           String @id @default(cuid())

  // The case that contains the citation
  citingCaseId String
  citingCase   PublicCase @relation("CitingCase", fields: [citingCaseId], references: [id], onDelete: Cascade)

  // The case being cited (nullable for unresolved citations)
  citedCaseId String?
  citedCase   PublicCase? @relation("CitedCase", fields: [citedCaseId], references: [id], onDelete: Cascade)

  // For unresolved citations (when citedCaseId is null, store raw citation text)
  externalRef String?

  // Citation context
  citationText String? // The neutral citation string as it appears
  context      String? @db.Text // Surrounding text where citation was found

  createdAt DateTime @default(now())

  // Ensure uniqueness for resolved citations (citedCaseId non-null)
  @@unique([citingCaseId, citedCaseId])
  // Ensure uniqueness for unresolved citations (externalRef non-null)
  @@unique([citingCaseId, externalRef])
  @@index([citingCaseId])
  @@index([citedCaseId])
  @@map("case_citations")
}

// RSS Source configuration
model RssSource {
  id              String   @id @default(cuid())
  
  // Source info
  name            String
  source          CaseSource @unique
  url             String
  
  // Status management
  isActive        Boolean  @default(true)
  status          RssSourceStatus @default(ACTIVE)
  lastError       String?  @db.Text
  lastFetchAt     DateTime?
  
  // Fetch strategy
  fetchInterval   Int      @default(3600)  // seconds
  maxRetries      Int      @default(3)
  retryDelay      Int      @default(300)   // seconds
  
  // Filter rules
  keywords        String[]
  excludeKeywords String[]
  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("rss_sources")
}

enum RssSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
  DEPRECATED
}

// Crawler Job Run - tracks each execution of the crawler for observability
model CrawlerJobRun {
  id            String            @id @default(cuid())
  
  // Trigger info
  triggeredBy   String            @default("scheduler") // "scheduler" | "manual" | "github_actions"
  
  // Status
  status        CrawlerRunStatus  @default(RUNNING)
  
  // Results
  totalAdded    Int               @default(0)
  totalSkipped  Int               @default(0)
  totalErrors   Int               @default(0)
  
  // Per-source breakdown (JSON: { sourceName: { added, skipped, errors } })
  sourceStats   Json?
  
  // AI Analysis
  aiAnalysisRan    Boolean        @default(false)
  aiAnalysisCount  Int            @default(0)
  
  // Error info
  errorMessage  String?           @db.Text
  
  // Timing
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  
  // Duration in seconds (computed on completion)
  durationSeconds Int?
  
  createdAt     DateTime          @default(now())
  
  @@index([status, startedAt])
  @@index([startedAt])
  @@map("crawler_job_runs")
}

enum CrawlerRunStatus {
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
}

// ============================================
// AI Pipeline Models (香港法案智能處理系統)
// ============================================

// Embedding 向量索引
model Embedding {
  id            String   @id @default(cuid())
  publicCaseId  String
  publicCase    PublicCase @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)
  
  // Embedding 資訊
  model         String   @default("text-embedding-3-large")
  dimensions    Int      @default(3072)
  // Legacy Float[] kept for backward compatibility; new writes also populate embeddingVectorV.
  embeddingVector Float[]
  // pgvector column: vector(3072) — used for ANN cosine-similarity search.
  // Populated by the add_pgvector_search.sql migration (requires pgvector extension).
  embeddingVectorV Unsupported("vector(3072)")? @map("embedding_vector_v")
  
  // Source text info
  sourceField   String   @default("content")
  tokenCount    Int?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([publicCaseId, sourceField])
  @@index([sourceField])
  @@index([publicCaseId])
  @@map("embeddings")
}

// NLP 分類結果
model Classification {
  id            String   @id @default(cuid())
  publicCaseId  String
  publicCase    PublicCase @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)
  
  // Classification results
  category      CaseCategory
  subCategory   String?
  confidence    Float
  keywords      String[]
  entities      Json?
  
  // Model info
  model         String   @default("gpt-5.1")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([publicCaseId])
  @@index([publicCaseId])
  @@index([category])
  @@map("classifications")
}

// 翻譯結果
model Translation {
  id            String   @id @default(cuid())
  publicCaseId  String
  publicCase    PublicCase @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)
  
  // Translation content
  sourceField   String
  sourceLang    String
  targetLang    String
  sourceText    String   @db.Text
  translatedText String  @db.Text
  
  // Quality
  model         String   @default("gpt-5.1")
  isReviewed    Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([publicCaseId, sourceField, targetLang])
  @@index([publicCaseId])
  @@map("translations")
}

// 摘要
model Summary {
  id            String   @id @default(cuid())
  publicCaseId  String
  publicCase    PublicCase @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)
  
  // Summary content (bilingual)
  summary_zh    String   @db.Text
  summary_en    String   @db.Text
  
  // Metadata
  sourceLength  Int
  summaryLength Int
  model         String   @default("gpt-5.1")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([publicCaseId])
  @@index([publicCaseId])
  @@map("summaries")
}
