generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User & Authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(CLIENT)
  keycloakId    String?   @unique
  avatar        String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  cases         Case[]    @relation("ClientCases")
  assignedCases Case[]    @relation("AssignedLawyer")
  activities    Activity[]
  documents     Document[]
  memberships   Membership[]
  
  @@map("users")
}

enum UserRole {
  ADMIN
  LAWYER
  CLIENT
  STAFF
}

// Case Management
model Case {
  id            String      @id @default(cuid())
  caseNumber    String      @unique // e.g., "HK-2026-001"
  title         String
  description   String?     @db.Text
  status        CaseStatus  @default(ACTIVE)
  priority      Priority    @default(MEDIUM)
  category      CaseCategory
  
  // Parties
  clientId      String
  client        User        @relation("ClientCases", fields: [clientId], references: [id])
  lawyerId      String?
  lawyer        User?       @relation("AssignedLawyer", fields: [lawyerId], references: [id])
  
  // Metadata
  startDate     DateTime    @default(now())
  endDate       DateTime?
  courtDate     DateTime?
  estimatedValue Decimal?   @db.Decimal(12, 2)
  
  // Visibility
  isPublic      Boolean     @default(false)
  publicNote    String?     @db.Text
  
  // Timestamps
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  documents     Document[]
  activities    Activity[]
  timeLogs      TimeLog[]
  invoices      Invoice[]
  notes         CaseNote[]
  
  @@map("cases")
  @@index([status, priority])
  @@index([clientId])
  @@index([lawyerId])
  @@index([caseNumber])
}

export enum CaseStatus {
  ACTIVE = "ACTIVE",
  PENDING = "PENDING",
  COMPLETED = "COMPLETED",
  ARCHIVED = "ARCHIVED",
  CANCELLED = "CANCELLED",
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CaseCategory {
  CIVIL
  CRIMINAL
  CORPORATE
  FAMILY
  PROPERTY
  EMPLOYMENT
  INTELLECTUAL_PROPERTY
  OTHER
}

// Client Information
model Client {
  id            String      @id @default(cuid())
  userId        String?
  
  // Personal/Company Info
  type          ClientType  @default(INDIVIDUAL)
  fullName      String
  companyName   String?
  idNumber      String?     @unique
  businessReg   String?     @unique
  
  // Contact
  email         String      @unique
  phone         String
  address       String?     @db.Text
  
  // Membership
  membershipTier MembershipTier @default(BASIC)
  
  // Timestamps
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@map("clients")
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum MembershipTier {
  BASIC
  STANDARD
  PREMIUM
  PREMIER
}

// Membership Records
model Membership {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  
  tier          MembershipTier
  startDate     DateTime    @default(now())
  endDate       DateTime?
  isActive      Boolean     @default(true)
  
  // Benefits
  searchLimit   Int         @default(10)  // searches per month
  caseLimit     Int?                      // max active cases
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@map("memberships")
  @@index([userId, isActive])
}

// Document Management
model Document {
  id            String      @id @default(cuid())
  caseId        String?
  case          Case?       @relation(fields: [caseId], references: [id])
  uploadedById  String
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])
  
  // File Info
  fileName      String
  fileSize      Int         // bytes
  fileType      String      // MIME type
  fileUrl       String      // S3/storage URL
  
  // Metadata
  category      DocumentCategory
  description   String?     @db.Text
  isConfidential Boolean    @default(false)
  
  // Timestamps
  uploadedAt    DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@map("documents")
  @@index([caseId])
}

enum DocumentCategory {
  CONTRACT
  EVIDENCE
  COURT_FILING
  CORRESPONDENCE
  INVOICE
  OTHER
}

// Activity Log
model Activity {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  caseId        String?
  case          Case?       @relation(fields: [caseId], references: [id])
  
  // Activity Details
  type          ActivityType
  action        String
  description   String?     @db.Text
  metadata      Json?       // Additional data
  
  // Timestamp
  createdAt     DateTime    @default(now())
  
  @@map("activities")
  @@index([userId, createdAt])
  @@index([caseId, createdAt])
}

enum ActivityType {
  CASE_CREATED
  CASE_UPDATED
  CASE_CLOSED
  DOCUMENT_UPLOADED
  CLIENT_ADDED
  MEETING_SCHEDULED
  PAYMENT_RECEIVED
  NOTE_ADDED
  STATUS_CHANGED
}

// Time Tracking
model TimeLog {
  id            String      @id @default(cuid())
  caseId        String
  case          Case        @relation(fields: [caseId], references: [id])
  
  // Time Details
  description   String
  hours         Decimal     @db.Decimal(5, 2)
  hourlyRate    Decimal?    @db.Decimal(8, 2)
  billable      Boolean     @default(true)
  
  // Date
  logDate       DateTime
  createdAt     DateTime    @default(now())
  
  @@map("time_logs")
  @@index([caseId, logDate])
}

// Billing
model Invoice {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique
  caseId        String
  case          Case        @relation(fields: [caseId], references: [id])
  
  // Amount
  amount        Decimal     @db.Decimal(12, 2)
  currency      String      @default("HKD")
  status        InvoiceStatus @default(PENDING)
  
  // Dates
  issueDate     DateTime    @default(now())
  dueDate       DateTime
  paidDate      DateTime?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@map("invoices")
  @@index([status, dueDate])
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// Case Notes
model CaseNote {
  id            String      @id @default(cuid())
  caseId        String
  case          Case        @relation(fields: [caseId], references: [id])
  
  content       String      @db.Text
  isPrivate     Boolean     @default(false)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@map("case_notes")
  @@index([caseId, createdAt])
}

// Public Case Search History (for non-members)
model SearchHistory {
  id            String      @id @default(cuid())
  ipAddress     String
  query         String
  resultsCount  Int
  searchedAt    DateTime    @default(now())
  
  @@map("search_history")
  @@index([ipAddress, searchedAt])
}
