{
  "name": "looper-hq",
  "version": "2.0.0",
  "private": true,
  "description": "Looper HQ - Enterprise-grade legal case management platform for Hong Kong",
  "author": "JonazWong",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@looper-hq/web",
    "dev:legal": "turbo run dev --filter=@looper-hq/legal-case-search",
    "dev:all": "turbo run dev --parallel",
    "postinstall": "pnpm --filter=@looper-hq/database generate",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky install"
    "db:migrate": "pnpm --filter=@looper-hq/database migrate",
    "db:push": "pnpm --filter=@looper-hq/database db:push",
    "db:seed": "pnpm --filter=@looper-hq/database seed",
    "db:seed:minimal": "pnpm --filter=@looper-hq/database seed:minimal",
    "db:studio": "pnpm --filter=@looper-hq/database studio",
    "bootstrap:data": "tsx scripts/bootstrap-data.ts",
    "migrate:all": "pnpm --filter=@looper-hq/migration migrate:all",
    "migrate:clients": "pnpm --filter=@looper-hq/migration migrate:clients",
    "migrate:cases": "pnpm --filter=@looper-hq/migration migrate:cases",
    "migrate:memberships": "pnpm --filter=@looper-hq/migration migrate:memberships",
    "migrate:validate": "pnpm --filter=@looper-hq/migration validate",
    "migrate:backup": "pnpm --filter=@looper-hq/migration backup",
    "migrate:rollback": "pnpm --filter=@looper-hq/migration rollback",
    "migrate:export-legacy": "pnpm --filter=@looper-hq/migration export:legacy",
    "pre-migration:check": "node scripts/pre-migration-check.js",
    "docker:up": "docker compose -p looper-hq -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -p looper-hq -f infrastructure/docker/docker-compose.yml down",
    "crawler:all": "pnpm exec dotenv -e .env -- tsx scripts/crawlers/unified-tracker.ts",
    "crawler:judiciary": "pnpm exec dotenv -e .env -- tsx scripts/crawlers/hk-judiciary-crawler.ts",
    "crawler:judiciary-dcl": "pnpm exec dotenv -e .env -- tsx scripts/crawlers/hk-judiciary-dcl-crawler.ts",
    "crawler:rss": "pnpm exec dotenv -e .env -- tsx scripts/crawlers/rss-news-crawler.ts",
    "crawler:health": "pnpm exec dotenv -e .env -- tsx scripts/crawlers/health-check.ts",
    "crawler:check": "pnpm exec dotenv -e .env -- tsx scripts/check-crawler-data.ts",
    "crawler:auto-check": "pnpm exec dotenv -e .env -- tsx scripts/crawlers/crawler-automation.ts",
    "crawler:auto-fix": "pnpm exec dotenv -e .env -- tsx scripts/crawlers/crawler-automation.ts --fix",
    "crawler:ensure-sources": "pnpm exec dotenv -e .env -- tsx scripts/ensure-rss-sources.ts",
    "crawler:verify-db": "pnpm exec dotenv -e .env -- tsx scripts/check-crawler-db-target.ts",
    "crawler:sync": "pnpm exec dotenv -e .env -- tsx scripts/sync-crawler-data.ts",
    "auth:ensure-demo-users": "tsx scripts/ensure-demo-users.ts",
    "payments:verify-airwallex": "tsx scripts/check-airwallex-config.ts",
    "test:rss": "tsx scripts/test-rss-sources.ts",
    "preview": "tsx scripts/preview-page.ts",
    "snapshot": "tsx scripts/snapshot-page.ts",
    "do:check": "bash scripts/do-bootstrap.sh",
    "close-issues": "node scripts/close-automated-issues.js",
    "close-issues:bash": "./scripts/close-automated-issues.sh"
  },
  "devDependencies": {
    "@octokit/rest": "^20.0.2",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@types/node": "^20.10.6",
    "axios": "^1.13.4",
    "cheerio": "^1.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^1.7.1",
    "flag": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "playwright": "^1.58.2",
    "prettier": "^3.1.1",
    "rss-parser": "^3.13.0",
    "tsx": "^4.7.0",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "prisma": "5.17.0",
      "@prisma/client": "5.17.0"
    }
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
