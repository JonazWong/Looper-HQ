{
  "name": "looper-hq",
  "version": "1.0.0",
  "private": true,
  "description": "Unified legal case management and inquiry platform for Hong Kong",
  "author": "JonazWong",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@looper-hq/web",
    "dev:legal": "turbo run dev --filter=@looper-hq/legal-case-search",
    "dev:all": "turbo run dev --parallel",
    "postinstall": "pnpm --filter=@looper-hq/database prisma generate",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter=@looper-hq/database migrate",
    "db:push": "pnpm --filter=@looper-hq/database db:push",
    "db:seed": "pnpm --filter=@looper-hq/database seed",
    "db:studio": "pnpm --filter=@looper-hq/database studio",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  }
}
