### Step 3: 創建爬蟲文件 (10 分鐘)

**創建文件 `lib/scrapers/judiciary-scraper.ts`**：

```typescript
import axios from "axios";
import * as cheerio from "cheerio";
import crypto from "crypto";

export interface CaseData {
  caseNumber: string;
  caseTitle: string;
  court: string;
  category: string;
  dateOfJudgment?: Date;
  judge?: string;
  parties: Array<{ name: string; role: string }>;
  sourceUrl: string;
  contentHash: string;
}

export class HKJudiciaryScraper {
  private readonly baseUrl = "https://www.judiciary.hk";
  private readonly delayMs = 2000;

  private async delay(ms: number): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  private calculateContentHash(content: string): string {
    return crypto.createHash('md5').update(content).digest('hex');
  }

  async scrapeCourtOfAppeal(): Promise<CaseData[]> {
    try {
      const url = "/en/services/opinions/index.html";
      await this.delay(this.delayMs);

      const response = await axios.get(`${this.baseUrl}${url}`, {
        headers: {
          'User-Agent': 'Mozilla/5.0 (compatible; HKLegal-Scraper/1.0)',
        },
      });

      const $ = cheerio.load(response.data);
      const cases: CaseData[] = [];

      $('table tbody tr').each((_, element) => {
        const $row = $(element);
        const caseNumber = $row.find('td:nth-child(1)').text().trim();
        const caseTitle = $row.find('td:nth-child(2)').text().trim();
        const dateStr = $row.find('td:nth-child(3)').text().trim();

        if (!caseNumber) return;

        cases.push({
          caseNumber,
          caseTitle,
          court: "Court of Appeal",
          category: "Civil Appeal",
          dateOfJudgment: this.parseDate(dateStr),
          sourceUrl: `${this.baseUrl}${url}`,
          contentHash: this.calculateContentHash(caseNumber + caseTitle),
          parties: this.extractParties(caseTitle),
        });
      });

      console.log(`✅ 高等法院: ${cases.length} 個案件`);
      return cases;
    } catch (error) {
      console.error(`❌ 高等法院抓取失敗:`, error);
      return [];
    }
  }

  private parseDate(dateStr: string): Date | undefined {
    if (!dateStr) return undefined;
    try {
      const date = new Date(dateStr);
      return isNaN(date.getTime()) ? undefined : date;
    } catch {
      return undefined;
    }
  }

  private extractParties(caseTitle: string): Array<{ name: string; role: string }> {
    const parts = caseTitle.split(/\s+v\s+/i);
    if (parts.length >= 2) {
      return [
        { name: parts[0].trim(), role: "Plaintiff" },
        { name: parts[1].trim(), role: "Defendant" },
      ];
    }
    return [];
  }
}

export const judiciaryScraper = new HKJudiciaryScraper();
```

### Step 4: 創建數據庫服務 (5 分鐘)

**創建文件 `lib/services/case-service.ts`**：

```typescript
import { db } from "@/lib/db";
import type { CaseData } from "@/lib/scrapers/judiciary-scraper";

export class CaseService {
  async saveCases(cases: CaseData[]): Promise<{ created: number; updated: number }> {
    let created = 0;
    let updated = 0;

    for (const caseData of cases) {
      try {
        const existing = await db.judicaryCase.findUnique({
          where: { caseNumber: caseData.caseNumber },
        });

        if (existing && existing.contentHash === caseData.contentHash) {
          continue;
        }

        if (existing) {
          await db.judicaryCase.update({
            where: { id: existing.id },
            data: { updatedAt: new Date() },
          });
          updated++;
        } else {
          const judicaryCase = await db.judicaryCase.create({
            data: {
              caseNumber: caseData.caseNumber,
              caseTitle: caseData.caseTitle,
              court: caseData.court,
              category: caseData.category,
              dateOfJudgment: caseData.dateOfJudgment,
              status: "Decided",
              sourceUrl: caseData.sourceUrl,
              sourceSite: "judiciary_hk",
              contentHash: caseData.contentHash,
            },
          });

          for (const party of caseData.parties) {
            await db.caseParty.create({
              data: {
                caseId: judicaryCase.id,
                name: party.name,
                role: party.role,
                type: "Individual",
              },
            });
          }

          created++;
        }
      } catch (error) {
        console.error(`保存案件 ${caseData.caseNumber} 失敗:`, error);
      }
    }

    console.log(`✅ 案件保存: ${created} 新增, ${updated} 更新`);
    return { created, updated };
  }

  async logScraperRun(source: string, status: string, stats: any) {
    await db.scraperLog.create({
      data: {
        source,
        status,
        totalCases: stats.total || 0,
        newCases: stats.created || 0,
        updatedCases: stats.updated || 0,
        errors: stats.errors,
      },
    });
  }
}

export const caseService = new CaseService();
```

### Step 5: 創建 Cron 端點 (5 分鐘)

**創建文件 `app/api/cron/scrape-judiciary/route.ts`**：

```typescript
import { NextRequest, NextResponse } from "next/server";
import { judiciaryScraper } from "@/lib/scrapers/judiciary-scraper";
import { caseService } from "@/lib/services/case-service";

export async function GET(request: NextRequest) {
  try {
    // 驗證 Cron Secret
    const authHeader = request.headers.get("authorization");
    if (authHeader !== `Bearer ${process.env.CRON_SECRET}`) {
      return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
    }

    console.log("🚀 開始爬蟲任務...");

    // 抓取案件
    const cases = await judiciaryScraper.scrapeCourtOfAppeal();

    // 保存到數據庫
    const result = await caseService.saveCases(cases);

    // 記錄日誌
    await caseService.logScraperRun("judiciary_hk", "success", {
      total: cases.length,
      ...result,
    });

    console.log("✅ 爬蟲任務完成");

    return NextResponse.json({
      success: true,
      cases: cases.length,
      created: result.created,
      updated: result.updated,
    });
  } catch (error) {
    console.error("❌ 爬蟲失敗:", error);

    await caseService.logScraperRun("judiciary_hk", "failed", {
      total: 0,
      created: 0,
      updated: 0,
      errors: error instanceof Error ? error.message : "Unknown error",
    });

    return NextResponse.json(
      { error: "Scraper failed" },
      { status: 500 }
    );
  }
}
```

