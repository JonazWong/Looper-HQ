# prisma/schema.prisma

model JudiciaryCase {
  id            String   @id @default(cuid())
  caseNumber    String   @unique
  caseTitle     String
  court         String   @db.VarChar(100)
  category      String   @db.VarChar(100)
  filingDate    DateTime?
